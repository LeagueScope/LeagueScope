# LeagueScope - Next.js Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API base URL (server-side only)
API_URL=http://localhost:3001/api/v1

# Public site URL for SEO (canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.leaguescope.com

# ─── LeagueScope Studio (PNG generator gateway) ─────────────────────────────
# Required by web/src/middleware.ts to unlock /studio-* and /api/leaguescope/*.
# If ANY of these are missing the routes fail-closed with 404 — no defaults,
# no escape hatches. Generate new values with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"   # slug
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"   # pass
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # cookie secret
STUDIO_SLUG=change-me-to-a-random-24+char-url-safe-string
STUDIO_USER=change-me
STUDIO_PASS=change-me
STUDIO_COOKIE_SECRET=change-me-to-a-random-48-byte-base64url-secret
