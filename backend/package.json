{
  "name": "leaguescope-backend",
  "version": "2.0.0",
  "description": "LeagueScope Backend — PostgreSQL + PandaScore",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --max-old-space-size=2048 src/index.js",
    "dev": "node --max-old-space-size=2048 --watch src/index.js",
    "start:prod": "NODE_ENV=production node --max-old-space-size=2048 src/index.js",
    "test": "node --test src/tests/aggregators.test.js",
    "test:watch": "node --test --watch src/tests/aggregators.test.js",
    "validate": "node scripts/validate-ingesta.js",
    "validate:fix": "node scripts/validate-ingesta.js --fix",
    "test:pipeline": "node scripts/test-pipeline.js",
    "ingest": "node scripts/fetch-to-postgres.js",
    "auto-ingest": "node scripts/auto-ingest.js",
    "auto-ingest:test": "node scripts/auto-ingest.js --max-leagues 1 --max-time 120",
    "poller": "node scripts/match-poller.js",
    "poller:once": "node scripts/match-poller.js --once",
    "poller:test": "node scripts/match-poller.js --once --leagues LEC,LCK"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.650.0",
    "@aws-sdk/client-sesv2": "^3.650.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  }
}
