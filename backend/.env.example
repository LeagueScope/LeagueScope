# LeagueScope Backend - Environment Config

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# PandaScore API
PANDASCORE_TOKEN=tu_token_aqui
PANDASCORE_PLAN=esports

# PostgreSQL
PG_DSN=postgresql://leaguescope_user:tu_contraseña@localhost:5432/leaguescope

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Live Data (futuro)
LIVE_UPDATE_INTERVAL=30000

# Default League
DEFAULT_LEAGUE=LEC
DEFAULT_YEAR=2026
